# Must be reachable by the browser: dataset bytes upload directly to this API.
SERVER_API_URL=http://127.0.0.1:8001
APP_ORIGIN=http://localhost:3001

# Match AGENT_AUTH_PROXY_SECRET on the API (generate with openssl rand -hex 32).
AUTH_PROXY_SECRET=
AUTH_CLIENT_IP_HEADER=

# For Netlify, set AUTH_CLIENT_IP_HEADER=x-nf-client-connection-ip.
