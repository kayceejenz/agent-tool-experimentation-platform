AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8001

# Existing PostgreSQL server, independent of any other application.
# This Mac uses host port 5433 mapped to PostgreSQL container port 5432.
AGENT_DATABASE_URL=postgresql://agent_platform_api:replace-with-runtime-password@127.0.0.1:5433/agent_platform
AGENT_DATABASE_POOL_MIN_SIZE=1
AGENT_DATABASE_POOL_MAX_SIZE=5
AGENT_DATABASE_POOL_TIMEOUT=2
AGENT_DATABASE_CONNECT_TIMEOUT=3
AGENT_DATABASE_READINESS_TIMEOUT=3

AGENT_MIGRATION_DATABASE_URL=postgresql://agent_platform:replace-with-owner-password@127.0.0.1:5433/agent_platform

AGENT_DATABASE_STATEMENT_TIMEOUT_MS=10000
AGENT_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
AGENT_DATABASE_LOCK_TIMEOUT_MS=2000

AGENT_APP_ENV=development
AGENT_AUTH_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
# AGENT_JWT_SECRET=
AGENT_JWT_ISSUER=agent-platform
AGENT_JWT_AUDIENCE=agent-platform-api
AGENT_ACCESS_TOKEN_MINUTES=15
AGENT_REFRESH_TOKEN_DAYS=30
AGENT_REGISTRATION_INVITATION_CODE=BETA
AGENT_REGISTRATION_RATE_LIMIT=5
AGENT_REGISTRATION_RATE_WINDOW_SECONDS=3600
AGENT_LOGIN_RATE_LIMIT=10
AGENT_LOGIN_RATE_WINDOW_SECONDS=900
